 // ── enable / disable / priority ─────────────────────────────
+
+// [local patch: reload-endpoint] Apply disk-config changes to a running server
+// in place, via POST /teamclaude/reload. Returns true when a server handled it.
+async function requestServerReload(config, opts = {}) {
+  const running = await findRunningServer(config);
+  if (!running) return { state: 'not-running' };
+  let res;
+  try {
+    const query = opts.resetAffinity ? '?resetAffinity=1' : '';
+    res = await fetch(`http://127.0.0.1:${running.port}/teamclaude/reload${query}`, { method: 'POST' });
+  } catch (err) {
+    return { state: 'unreachable', detail: err.message };
+  }
+  if (res.status === 404) return { state: 'unsupported' }; // server predates the patch
+  if (!res.ok) return { state: 'failed', detail: `HTTP ${res.status}` };
+  const body = await res.json().catch(() => ({}));
+  return { state: 'ok', body };
+}
+
+async function reloadCommand() {
+  const config = await loadConfig();
+  if (!config) { console.error('No config found.'); process.exit(1); }
+  const r = await requestServerReload(config);
+  switch (r.state) {
+    case 'not-running':
+      console.log('No running server — nothing to reload (start one with: teamclaude server).');
+      return;
+    case 'unsupported':
+      console.error('The running server predates the reload endpoint — restart once: teamclaude restart');
+      process.exit(1);
+      break;
+    case 'unreachable':
+    case 'failed':
+      console.error(`Reload failed: ${r.detail}`);
+      process.exit(1);
+      break;
+    case 'ok': {
+      const added = r.body?.added || 0;
+      console.log(added > 0
+        ? `Reloaded config — picked up ${added} new account(s).`
+        : 'Reloaded config — enable/disable/priority/credential changes applied.');
+      if (r.body?.quotaProbed === -1 || r.body?.quotaProbed == null) {
+        console.log('  (quota re-measure skipped — no request has flowed through the proxy yet)');
+      }
+      return;
+    }
+  }
+}
 
+// [local patch: reload-endpoint] Make one account the preferred target NOW:
+// enable it, give it priority 1, return every other account to automatic
+// ordering, and reset connection affinity on the running server so sessions
+// that are already running move over on their next request. Accepts the
+// account number (in `teamclaude accounts` order) or the account name.
+async function switchCommand() {
+  const target = args[1];
+  if (!target) {
+    console.error('Usage: teamclaude switch <number|account-name>');
+    console.error('  Numbers follow the `teamclaude accounts` order.');
+    process.exit(1);
+  }
+  let name = null;
+  const config = await atomicConfigUpdate(cfg => {
+    const acct = /^\d+$/.test(target)
+      ? (cfg.accounts[Number(target) - 1] || null)
+      : (cfg.accounts.find(a => a.name === target) || null);
+    if (!acct) return;
+    name = acct.name;
+    for (const a of cfg.accounts) {
+      if (a === acct) { delete a.enabled; a.priority = 1; }
+      else if (a.priority !== undefined) delete a.priority; // back to auto ordering
+    }
+  });
+  if (!name) { console.error(`Account not found: ${target}`); process.exit(1); }
+  console.log(`Switched preferred account to "${name}" (enabled, priority 1; others on auto order).`);
+  const r = await requestServerReload(config, { resetAffinity: true });
+  if (r.state === 'ok') {
+    console.log('Applied to the running server — running sessions move over on their next request.');
+  } else if (r.state === 'not-running') {
+    console.log('No running server; takes effect when one starts.');
+  } else if (r.state === 'unsupported') {
+    console.log('The running server predates the reload endpoint — restart once: teamclaude restart');
+  } else {
+    console.log(`Could not apply live (${r.detail || r.state}) — apply with: teamclaude restart`);
+  }
+}
